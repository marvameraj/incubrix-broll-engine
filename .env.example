APP_ENV=development
API_AUTH_TOKEN=incubrix-demo-token
WEBHOOK_SECRET=incubrix-webhook-secret
RATE_LIMIT_PER_MINUTE=300

LLM_PROVIDER=mock
FOOTAGE_PROVIDER=wikimedia
SECONDARY_FOOTAGE_PROVIDER=archive_org
TTS_PROVIDER=edge
ASR_PROVIDER=whisper

GEMINI_API_KEY=
PIXABAY_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
WHISPER_MODEL_SIZE=base
MAX_AUDIO_DURATION_SEC=600
MIN_SCENE_DURATION_SEC=2.0

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./outputs
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incubrix-broll